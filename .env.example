# Copy these into the .env file on the live server (see DEPLOY_PYTHONANYWHERE.md).
# On your own laptop you don't need any of them.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=paste-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=erp.murimi.co.zw
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.murimi.co.zw
POSTGRES_DB=murimi_erp
POSTGRES_USER=murimi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Exchange rates: fetch today's ZiG and rand rates online (True/False)
MURIMI_RATES_AUTO=True

# Fiscal device: "manual" means you type in the receipt number from your own fiscal device.
MURIMI_FISCAL_DEVICE=manual

# The Android app: the SHA-256 fingerprint of your signing key (from android-signing/KEY-INFO.txt)
ANDROID_PACKAGE=zw.murimi.erp
ANDROID_CERT_SHA256=AA:BB:...
